# Rust build artifacts
/target
/desktop/target

# Packaged installers / distributables (built locally, never part of source backup)
/dist/
/dist-windows/
/AlgoTradingSetup.exe
/AlgoTradingApp.zip
/crates/server/static/AlgoTradingSetup.exe
/crates/server/static/AlgoTradingApp.zip
*.exe
*.zip

# Runtime state (realtime engine persisted state)
/data/

# Windows release backup: the installer + binaries ARE the backup, so keep them
# even though *.exe / *.zip are ignored everywhere else.
!/backup/windows/**
!/backup/windows/**/*.exe
!/backup/windows/**/*.zip
!/backup/windows/**/*.dll

# Backup & Restore runtime config (machine-specific backup path/schedule)
backup_config.json

# OS / editor junk
.DS_Store
*.swp
